---
import SEO from '@components/SEO.astro';
import type { Props as SEOProps } from '@components/SEO.astro';
import '@styles/global.css';
// Hashed URLs for the two Hebrew subsets, so they can be preloaded. Every
// visible word here is Hebrew, and the H1 — the LCP element — is set in
// Rubik: preloading it means the heading paints final rather than
// painting in a fallback and re-firing LCP when the swap lands.
// Measured (prod build, slow-4G + 4x CPU, median of 5): no preload
// 1656ms LCP, Assistant only 1504ms, heading face only 1148ms, both 1136ms
// with CLS 0. Worth re-measuring before adding a third — when the Latin
// serif was still loading, preloading both was the *worst* option.
import assistantHebrew from '@fontsource-variable/assistant/files/assistant-hebrew-wght-normal.woff2?url';
import headingHebrew from '@fontsource-variable/rubik/files/rubik-hebrew-wght-normal.woff2?url';

export interface Props extends SEOProps {
  bodyClass?: string;
}

const { bodyClass, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fdfbf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100804" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href={assistantHebrew} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={headingHebrew} as="font" type="font/woff2" crossorigin />

    <SEO {...seoProps} />

    <slot name="head" />
  </head>

  <body class={`min-h-svh flex flex-col${bodyClass ? ` ${bodyClass}` : ''}`}>
    <!-- Skip navigation for screen readers and keyboard users -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-teal-800 focus:px-4 focus:py-2 focus:text-white focus:outline-none"
    >
      דלג לתוכן הראשי
    </a>

    <slot name="header" />

    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>

    <slot name="footer" />

    <!-- Fixed overlays (sticky bars, modals) — keeps them inside <body> -->
    <slot name="overlay" />

    <!-- Slot for page-level scripts -->
    <slot name="scripts" />

    <script>
      // Scroll-reveal: fade-in-up for all sections except hero
      const observer = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('reveal-in');
              observer.unobserve(e.target);
            }
          }),
        // Fire while the section is still below the fold, not once it is
        // already on screen. threshold: 0.08 meant 8% of the section had to be
        // inside the root before the reveal even started, and on sections this
        // tall that is a lot: 145px for Services, 109px for About. The -48px
        // bottom margin delayed it further. Measured over a scroll through the
        // page, every section spent ~650ms visibly translucent, with up to
        // 333px of it on screen at opacity 0 - which is what reads as the
        // section "fading out in front of you".
        //
        // threshold 0 plus a root extended 15% of a viewport downwards gives
        // the 0.65s transition a head start, so the fade is finishing as the
        // section crosses the fold rather than starting there. 15% and not
        // more: at 25% the animation always completed off screen, which is the
        // same as not having one.
        { threshold: 0, rootMargin: '0px 0px 15% 0px' }
      );
      document.querySelectorAll('section:not(#hero)').forEach((el) => {
        el.classList.add('reveal-init');
        observer.observe(el);
      });
    </script>
  </body>
</html>

---
import { Image } from 'astro:assets';
import { SITE } from '@data/site';
import contactBg from '../assets/clinic.png';

const contactItems = [
  {
    id: 'phone',
    label: 'טלפון',
    value: SITE.phone,
    href: `tel:${SITE.phoneE164}`,
    ariaLabel: `חייגו לגל עופרי: ${SITE.phone}`,
    iconPath:
      'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.62 3.33a2 2 0 0 1 2-1.72h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6.94 6.94l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z',
  },
  {
    id: 'email',
    label: 'אימייל',
    value: SITE.email,
    href: `mailto:${SITE.email}`,
    ariaLabel: `שלחו אימייל לגל עופרי: ${SITE.email}`,
    iconPath:
      'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6l-10 7L2 6',
  },
  {
    id: 'location',
    label: 'מיקום',
    value: `${SITE.address.street}, ${SITE.address.cityHebrew}`,
    href: `https://maps.google.com/?q=${encodeURIComponent(SITE.address.street + ', ' + SITE.address.cityHebrew)}`,
    ariaLabel: `פתח מפה: ${SITE.address.street}, ${SITE.address.cityHebrew}`,
    iconPath: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z M12 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
  },
];
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="section-padding relative overflow-hidden"
>
  <!-- Full-bleed background image + dark overlay -->
  <div class="absolute inset-0" aria-hidden="true">
    <Image
      src={contactBg}
      alt=""
      width={1440}
      height={900}
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      loading="lazy"
      class="h-full w-full object-cover object-center"
    />
    <div class="bg-navy-900/70 absolute inset-0"></div>
  </div>

  <div class="container-prose relative z-10">
    <!-- Section header -->
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <p class="text-accent-gold text-xs font-semibold tracking-[0.15em] uppercase">צור קשר</p>
      <h2 id="contact-heading" class="font-heading mt-3 text-3xl font-bold text-white md:text-4xl">
        בואו נתחיל בתהליך ביחד
      </h2>
    </div>

    <!-- 2-column grid: info (right in RTL) + form (left in RTL) -->
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
      <!-- ── Contact info — glassmorphism panel ── -->
      <div class="flex flex-col gap-5">
        <div
          class="rounded-3xl bg-white/8 p-6 ring-1 ring-white/15 lg:p-8"
          style="backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);"
        >
          <div class="space-y-5" role="list" aria-label="פרטי יצירת קשר">
            {
              contactItems.map((item) => (
                <div role="listitem" class="flex items-center gap-3">
                  <div
                    class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/12 ring-1 ring-white/20"
                    aria-hidden="true"
                  >
                    <svg
                      class="text-accent-gold h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={item.iconPath
                        .split(' M')
                        .map((d, i) => `<path d="${i === 0 ? d : 'M' + d}"/>`)
                        .join('')}
                    />
                  </div>
                  <div>
                    <p class="text-xs font-semibold tracking-wide text-white/85">{item.label}</p>
                    <a
                      href={item.href}
                      aria-label={item.ariaLabel}
                      class="hover:text-accent-gold tap-target mt-0.5 block text-base font-medium text-white transition-colors"
                      dir={item.id === 'phone' ? 'ltr' : undefined}
                      {...(item.id === 'location'
                        ? { target: '_blank', rel: 'noopener noreferrer' }
                        : {})}
                    >
                      {item.value}
                    </a>
                  </div>
                </div>
              ))
            }
          </div>

          <!-- Hairline divider -->
          <div class="my-5 h-px bg-white/12" aria-hidden="true"></div>

          <!-- Opening hours — derived from SITE.openingHours, same source as the
               JSON-LD, so the two can never drift apart. -->
          <div class="flex items-start gap-3">
            <div
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/12 ring-1 ring-white/20"
              aria-hidden="true"
            >
              <svg
                class="text-accent-gold h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7v5l3 2"></path>
              </svg>
            </div>
            <div>
              <p class="text-xs font-semibold tracking-wide text-white/85">שעות פעילות</p>
              <dl class="mt-0.5 space-y-0.5">
                {
                  SITE.openingHours.map((slot) => (
                    <div class="flex items-baseline gap-2 text-base font-medium text-white">
                      <dt>{slot.daysHebrew}</dt>
                      <dd dir="ltr" class="tabular-nums">
                        {slot.opens}&ndash;{slot.closes}
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>

          <!-- Hairline divider -->
          <div class="my-5 h-px bg-white/12" aria-hidden="true"></div>

          <!-- Navigation buttons -->
          <div class="flex flex-wrap gap-2" role="group" aria-label="כלי ניווט לקליניקה">
            <a
              href={`https://maps.google.com/?q=${encodeURIComponent(SITE.address.street + ', ' + SITE.address.cityHebrew)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl border border-white/20 px-3.5 py-2 text-xs font-medium text-white/85 transition-colors duration-200 hover:border-white/40 hover:text-white"
              aria-label="ניווט לקליניקה ב-Google Maps"
            >
              <!-- Google Maps' own mark (Simple Icons), not a generic pin: it sits
                   next to the Waze mark and the two have to read as the same kind
                   of thing — both are brand glyphs, solid, filled with currentColor. -->
              <svg
                class="h-3.5 w-3.5 shrink-0"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M19.527 4.799c1.212 2.608.937 5.678-.405 8.173-1.101 2.047-2.744 3.74-4.098 5.614-.619.858-1.244 1.75-1.669 2.727-.141.325-.263.658-.383.992-.121.333-.224.673-.34 1.008-.109.314-.236.684-.627.687h-.007c-.466-.001-.579-.53-.695-.887-.284-.874-.581-1.713-1.019-2.525-.51-.944-1.145-1.817-1.79-2.671L19.527 4.799zM8.545 7.705l-3.959 4.707c.724 1.54 1.821 2.863 2.871 4.18.247.31.494.622.737.936l4.984-5.925-.029.01c-1.741.601-3.691-.291-4.392-1.987a3.377 3.377 0 0 1-.209-.716c-.063-.437-.077-.761-.004-1.198l.001-.007zM5.492 3.149l-.003.004c-1.947 2.466-2.281 5.88-1.117 8.77l4.785-5.689-.058-.05-3.607-3.035zM14.661.436l-3.838 4.563a.295.295 0 0 1 .027-.01c1.6-.551 3.403.15 4.22 1.626.176.319.323.683.377 1.045.068.446.085.773.012 1.22l-.003.016 3.836-4.561A8.382 8.382 0 0 0 14.67.439l-.009-.003zM9.466 5.868L14.162.285l-.047-.012A8.31 8.31 0 0 0 11.986 0a8.439 8.439 0 0 0-6.169 2.766l-.016.018 3.665 3.084z"
                ></path>
              </svg>
              Google Maps
            </a>
            <a
              href="https://waze.com/ul?q=Bloch%2038%20Tel%20Aviv"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl border border-white/20 px-3.5 py-2 text-xs font-medium text-white/85 transition-colors duration-200 hover:border-white/40 hover:text-white"
              aria-label="ניווט לקליניקה ב-Waze"
            >
              <!-- Waze's actual logo (Simple Icons), not the navigation arrow that
                   used to sit here — that arrow is a generic "send"/compass glyph
                   and nothing about it says Waze. -->
              <svg
                class="h-3.5 w-3.5 shrink-0"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M13.218 0C9.915 0 6.835 1.49 4.723 4.148c-1.515 1.913-2.31 4.272-2.31 6.706v1.739c0 .894-.62 1.738-1.862 1.813-.298.025-.547.224-.547.522-.05.82.82 2.31 2.012 3.502.82.844 1.788 1.515 2.832 2.036a3 3 0 0 0 2.955 3.528 2.966 2.966 0 0 0 2.931-2.385h2.509c.323 1.689 2.086 2.856 3.974 2.21 1.64-.546 2.36-2.409 1.763-3.924a12.84 12.84 0 0 0 1.838-1.465 10.73 10.73 0 0 0 3.18-7.65c0-2.882-1.118-5.589-3.155-7.625A10.899 10.899 0 0 0 13.218 0zm0 1.217c2.558 0 4.967.994 6.78 2.807a9.525 9.525 0 0 1 2.807 6.78A9.526 9.526 0 0 1 20 17.585a9.647 9.647 0 0 1-6.78 2.807h-2.46a3.008 3.008 0 0 0-2.93-2.41 3.03 3.03 0 0 0-2.534 1.367v.024a8.945 8.945 0 0 1-2.41-1.788c-.844-.844-1.316-1.614-1.515-2.11a2.858 2.858 0 0 0 1.441-.846 2.959 2.959 0 0 0 .795-2.036v-1.789c0-2.11.696-4.197 2.012-5.861 1.863-2.385 4.62-3.726 7.6-3.726zm-2.41 5.986a1.192 1.192 0 0 0-1.191 1.192 1.192 1.192 0 0 0 1.192 1.193A1.192 1.192 0 0 0 12 8.395a1.192 1.192 0 0 0-1.192-1.192zm7.204 0a1.192 1.192 0 0 0-1.192 1.192 1.192 1.192 0 0 0 1.192 1.193 1.192 1.192 0 0 0 1.192-1.193 1.192 1.192 0 0 0-1.192-1.192zm-7.377 4.769a.596.596 0 0 0-.546.845 4.813 4.813 0 0 0 4.346 2.757 4.77 4.77 0 0 0 4.347-2.757.596.596 0 0 0-.547-.845h-.025a.561.561 0 0 0-.521.348 3.59 3.59 0 0 1-3.254 2.061 3.591 3.591 0 0 1-3.254-2.061.64.64 0 0 0-.546-.348z"
                ></path>
              </svg>
              Waze
            </a>
          </div>
        </div>
      </div>

      <!-- ── Contact form — pure white card ── -->
      <div
        class="rounded-3xl bg-white px-6 py-8 shadow-[0_8px_48px_-8px_rgb(0_0_0_/_0.45)] ring-1 ring-white/20 lg:px-8 lg:py-8"
      >
        <div id="form-intro">
          <h3 class="font-heading text-2xl font-bold text-neutral-900">
            השאירו פרטים ואחזור אליכם בהקדם
          </h3>
          <p class="mt-1.5 text-sm text-neutral-600">
            ספרו לי על הכאב שלכם, ונמצא יחד את הפתרון הנכון.
          </p>
        </div>

        <!-- Success state (hidden until form submit) -->
        <div id="form-success" class="hidden py-10 text-center" role="status" tabindex="-1">
          <div
            class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-teal-50 ring-1 ring-teal-200"
            aria-hidden="true"
          >
            <svg
              class="h-8 w-8 text-teal-600"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round"
              ></polyline>
            </svg>
          </div>
          <h3 class="font-heading text-xl font-bold text-neutral-900">הפנייה נשלחה!</h3>
          <p class="mt-2 text-sm leading-relaxed text-balance text-neutral-600">
            נחזור אליכם תוך יום עסקים אחד.<br />לתגובה מהירה יותר, שלחו הודעה בוואטסאפ.
          </p>
          <a
            href={SITE.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-whatsapp/10 text-whatsapp-ink ring-whatsapp-ink/30 hover:bg-whatsapp/20 mt-6 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold ring-1 transition"
            aria-label="שלחו הודעה מהירה בוואטסאפ"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
              ></path>
            </svg>
            המשיכו בוואטסאפ
          </a>
        </div>

        <!-- Error state -->
        <div
          id="form-error-state"
          class="mt-4 hidden rounded-2xl bg-red-50 px-5 py-4 text-sm text-red-700 ring-1 ring-red-200"
          role="alert"
          aria-live="assertive"
          tabindex="-1"
        >
          שגיאה בשליחת הטופס. אנא נסו שוב, או פנו אלינו ישירות בוואטסאפ.
        </div>

        <form id="contact-form" novalidate aria-label="טופס יצירת קשר" class="mt-6 space-y-5">
          <input type="hidden" name="access_key" value="49897137-159e-46be-ad04-79aaf78b0595" />
          <input type="hidden" name="subject" value="פנייה חדשה מהאתר: גל עופרי פיזיותרפיה" />
          <!-- Honeypot: invisible to real visitors, catches basic form-filling bots. Web3Forms rejects submissions where this is checked. -->
          <input
            type="checkbox"
            name="botcheck"
            id="contact-botcheck"
            class="hidden"
            tabindex="-1"
            autocomplete="off"
          />

          <!-- Name -->
          <div class="form-field">
            <input
              type="text"
              id="contact-name"
              name="name"
              autocomplete="name"
              required
              aria-required="true"
              placeholder=" "
              class="form-input"
            />
            <label for="contact-name" class="form-float-label">שם מלא</label>
            <p class="form-error hidden" id="name-error" role="alert"></p>
          </div>

          <!-- Phone -->
          <div class="form-field">
            <input
              type="tel"
              id="contact-phone"
              name="phone"
              autocomplete="tel"
              required
              aria-required="true"
              dir="ltr"
              placeholder=" "
              class="form-input text-start"
            />
            <label for="contact-phone" class="form-float-label">מספר טלפון</label>
            <p class="form-error hidden" id="phone-error" role="alert"></p>
          </div>

          <!-- Message -->
          <div>
            <div class="form-field">
              <textarea
                id="contact-message"
                name="message"
                rows={3}
                required
                aria-required="true"
                placeholder="ספרו לי קצת על הכאב או הצורך שלכם..."
                class="form-input resize-none"></textarea>
              <label for="contact-message" class="form-float-label">הודעה</label>
            </div>
            <p class="form-error hidden" id="message-error" role="alert"></p>
          </div>

          <!-- Submit -->
          <div class="pt-2">
            <button
              type="submit"
              id="submit-btn"
              class="btn-primary w-full py-3.5"
              aria-label="שלחו את הפנייה לגל עופרי"
            >
              <span id="submit-text">שלחו הודעה</span>
              <svg
                id="submit-spinner"
                class="hidden h-4 w-4 animate-spin"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"></circle>
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
            </button>
            {
              /* Starts where every other line in this card starts. Centred, it
                was the only prose in the card not on the form's start edge, and
                on a phone it is two lines - centred multi-line running text is
                harder to scan than centred one-liners look. The button's own
                label stays centred, because that belongs to the button. */
            }
            <p class="mt-3 text-xs text-neutral-600">
              הפרטים משמשים אך ורק ליצירת קשר איתכם. לפרטים נוספים,{' '}
              <a
                href="/privacy"
                class="text-teal-700 underline underline-offset-2 transition-colors hover:text-teal-800"
                >מדיניות הפרטיות</a
              >.
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successEl = document.getElementById('form-success')!;
  const errorEl = document.getElementById('form-error-state')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const submitText = document.getElementById('submit-text')!;
  const submitSpinner = document.getElementById('submit-spinner')!;
  const introEl = document.getElementById('form-intro')!;

  function showError(inputId: string, errorId: string, message: string) {
    const input = document.getElementById(inputId) as HTMLElement;
    const error = document.getElementById(errorId)!;
    input.setAttribute('aria-invalid', 'true');
    input.setAttribute('aria-describedby', errorId);
    error.textContent = message;
    error.classList.remove('hidden');
  }

  function clearError(inputId: string, errorId: string) {
    const input = document.getElementById(inputId) as HTMLElement;
    const error = document.getElementById(errorId)!;
    input.removeAttribute('aria-invalid');
    input.removeAttribute('aria-describedby');
    error.textContent = '';
    error.classList.add('hidden');
  }

  // Count digits rather than total characters: the old character-range test
  // rejected '+972 50 123 4567' (16 chars) while accepting '+++++++'.
  function isValidPhone(value: string): boolean {
    if (/[^\d\s\-+().]/.test(value)) return false;
    const digits = value.replace(/\D/g, '');
    return digits.length >= 9 && digits.length <= 15;
  }

  function validate(): boolean {
    let valid = true;
    const name = (document.getElementById('contact-name') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('contact-phone') as HTMLInputElement).value.trim();
    const message = (
      document.getElementById('contact-message') as HTMLTextAreaElement
    ).value.trim();

    clearError('contact-name', 'name-error');
    clearError('contact-phone', 'phone-error');
    clearError('contact-message', 'message-error');

    if (!name) {
      showError('contact-name', 'name-error', 'שם מלא הוא שדה חובה.');
      valid = false;
    }
    if (!phone) {
      showError('contact-phone', 'phone-error', 'מספר טלפון הוא שדה חובה.');
      valid = false;
    } else if (!isValidPhone(phone)) {
      showError('contact-phone', 'phone-error', 'אנא הכניסו מספר טלפון תקין.');
      valid = false;
    }
    if (!message) {
      showError('contact-message', 'message-error', 'הודעה היא שדה חובה.');
      valid = false;
    }
    if (!valid) {
      // Without this the user is left focused on the submit button, with the
      // errors above it and often scrolled out of view on a phone.
      // focus() scrolls the field into view on its own, and unlike an explicit
      // scrollIntoView({ behavior: 'smooth' }) it honours prefers-reduced-motion.
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
    }
    return valid;
  }

  function showSuccess() {
    form.classList.add('hidden');
    introEl.classList.add('hidden');
    errorEl.classList.add('hidden');
    successEl.classList.remove('hidden');
    successEl.focus();
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate()) return;

    const botcheck = (document.getElementById('contact-botcheck') as HTMLInputElement).checked;
    if (botcheck) {
      // Bot filled the hidden honeypot field — pretend success, send nothing.
      showSuccess();
      return;
    }

    submitBtn.disabled = true;
    submitText.textContent = 'שולח...';
    submitSpinner.classList.remove('hidden');
    errorEl.classList.add('hidden');

    try {
      const accessKey = (form.querySelector('[name="access_key"]') as HTMLInputElement).value;
      const name = (document.getElementById('contact-name') as HTMLInputElement).value.trim();
      const phone = (document.getElementById('contact-phone') as HTMLInputElement).value.trim();
      const message = (
        document.getElementById('contact-message') as HTMLTextAreaElement
      ).value.trim();

      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: accessKey,
          subject: 'פנייה חדשה מהאתר: גל עופרי פיזיותרפיה',
          name,
          phone,
          message,
          botcheck,
        }),
      });

      // Web3Forms can answer 200 with { success: false } (inactive form, bad
      // key, quota). Trusting res.ok alone showed the visitor a success screen
      // while the lead was dropped.
      if (!res.ok) throw new Error('Submission failed');
      const payload = await res.json().catch(() => null);
      if (payload && payload.success === false) throw new Error('Submission rejected');

      showSuccess();
    } catch {
      submitBtn.disabled = false;
      submitText.textContent = 'שלחו הודעה';
      submitSpinner.classList.add('hidden');
      errorEl.classList.remove('hidden');
      errorEl.focus();
    }
  });
</script>

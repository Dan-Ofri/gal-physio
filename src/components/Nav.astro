---
import { SITE } from '@data/site';

const links = [
  { href: '#about', label: 'אודות' },
  { href: '#services', label: 'שירותים' },
  { href: '#testimonials', label: 'המלצות' },
  { href: '#contact', label: 'יצירת קשר' },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50" aria-label="כותרת אתר">
  <div class="container-prose flex items-center py-2 md:py-3 lg:justify-between">
    <!-- Mobile: hamburger (right=start in RTL); hidden on desktop -->
    <button
      id="nav-toggle"
      type="button"
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-neutral-700 transition-colors hover:bg-neutral-100 hover:text-teal-600 active:bg-neutral-200 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="פתח תפריט ניווט"
    >
      <svg
        class="h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line x1="4" y1="7" x2="20" y2="7" stroke-linecap="round"></line>
        <line x1="4" y1="12" x2="20" y2="12" stroke-linecap="round"></line>
        <line x1="4" y1="17" x2="20" y2="17" stroke-linecap="round"></line>
      </svg>
    </button>

    <!-- Logo — centered on mobile (flex-1 + justify-center), natural start on desktop -->
    <div class="flex flex-1 items-center justify-center lg:flex-none lg:justify-start">
      <a
        href="/"
        aria-label={`${SITE.name}: עמוד הבית`}
        class="shrink-0 transition-opacity hover:opacity-85"
      >
        <img src="/logo-compact.svg" alt="" class="h-14 w-auto md:h-16" width="870" height="786" />
      </a>
    </div>

    <!-- Calendar shortcut — mirrors hamburger size, keeps logo centred on mobile -->
    <a
      id="nav-cal-btn"
      href="#contact"
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-teal-200 text-teal-600 transition-colors hover:border-teal-300 hover:bg-teal-50 active:bg-teal-100 lg:hidden"
      aria-label="לקביעת תור"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-linejoin="round"></rect>
        <path stroke-linecap="round" d="M16 2v4M8 2v4M3 10h18"></path>
      </svg>
    </a>

    <!-- Desktop Nav Links; hidden on mobile -->
    <nav aria-label="ניווט ראשי" class="hidden items-center gap-2 lg:flex">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            class="relative rounded-lg px-5 py-2 text-sm font-medium text-neutral-700 transition-colors duration-200 hover:text-teal-600 focus-visible:text-teal-600"
          >
            {label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop Actions; hidden on mobile -->
    <div class="hidden items-center gap-4 lg:flex">
      <a
        href={`tel:${SITE.phoneE164}`}
        aria-label={`חייג ל-${SITE.name}: ${SITE.phone}`}
        class="flex items-center gap-1.5 py-1.5 text-sm font-medium text-neutral-600 transition-colors hover:text-neutral-800"
      >
        <svg
          class="h-4 w-4 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.62 3.33a2 2 0 0 1 2-1.72h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6.94 6.94l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span dir="ltr" class="tracking-wide">{SITE.phone}</span>
      </a>
      <a
        href={SITE.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-whatsapp-ink flex h-11 w-11 items-center justify-center rounded-full text-neutral-700 transition-colors"
        aria-label="שלחו הודעה לגל עופרי בוואטסאפ"
      >
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
          ></path>
        </svg>
      </a>
      <a
        href="#contact"
        class="btn-primary py-2.5 text-sm"
        aria-label="לחצו לתיאום ייעוץ ראשוני עם גל עופרי פיזיותרפיה"
      >
        לתיאום ייעוץ ראשוני
      </a>
    </div>
  </div>
</header>

<!-- ── Mobile Menu Overlay ── -->
<div id="mobile-menu" role="dialog" aria-modal="true" aria-label="תפריט ניווט">
  <!-- Top bar: close (right in RTL), logo (center), spacer (left).
       Padding and logo size mirror the header's exactly, so opening the menu
       cross-fades the hamburger into this X in place instead of shifting the
       logo. Keep the two in sync if either changes. -->
  <div class="container-prose grid grid-cols-[2.75rem_1fr_2.75rem] items-center gap-3 py-2 md:py-3">
    <button
      id="nav-close-btn"
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-xl text-neutral-700 transition-colors hover:bg-neutral-100 hover:text-neutral-800"
      aria-label="סגור תפריט ניווט"
    >
      <svg
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
    <a href="/" aria-label={`${SITE.name}: עמוד הבית`} class="flex justify-center">
      <img src="/logo-compact.svg" alt="" class="h-14 w-auto md:h-16" width="870" height="786" />
    </a>
    <div aria-hidden="true"></div>
  </div>

  <!-- Nav links (centered, full height) -->
  <nav
    aria-label="תפריט ניווט נייד"
    class="flex flex-1 flex-col items-center justify-center gap-2 px-6"
  >
    {
      links.map(({ href, label }) => (
        <a
          href={href}
          class="w-full rounded-2xl py-4 text-center text-xl font-semibold text-neutral-700 transition-[background-color,color,transform] duration-150 hover:bg-neutral-100 hover:text-teal-700 active:scale-[0.97]"
        >
          {label}
        </a>
      ))
    }
  </nav>

  <!-- Bottom CTA area -->
  <div class="container-prose flex flex-col gap-3 pt-4 pb-10">
    <a
      href="#contact"
      class="btn-primary justify-center py-4 text-base"
      aria-label="תיאום ייעוץ ראשוני ופגישה ראשונה עם גל עופרי"
    >
      <svg
        class="h-5 w-5 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-linejoin="round"></rect>
        <path stroke-linecap="round" d="M16 2v4M8 2v4M3 10h18"></path>
      </svg>
      תיאום ייעוץ ראשוני
    </a>
    <a
      href={`tel:${SITE.phoneE164}`}
      class="flex items-center justify-center gap-2 text-sm text-neutral-700 transition-colors hover:text-neutral-800"
      aria-label={`חייג: ${SITE.phone}`}
    >
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.62 3.33a2 2 0 0 1 2-1.72h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6.94 6.94l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span dir="ltr">{SITE.phone}</span>
    </a>
  </div>
</div>

<style>
  /* ── Header scroll state ──
     The header is transparent at rest so the hero's blurred colour washes run
     continuously underneath it. Painting a solid --color-neutral-50 here used
     to clip that wash at the header's bottom edge, which read as a hard seam
     across the full width (measured: #FDFBF7 at 70px, #FEF2EA at 72px).

     The blur is applied only in the scrolled state, and therefore snaps
     rather than ramping. Keeping `backdrop-filter: blur(0px)` on the header
     at all times is what makes it interpolate, and that was tried: over a
     scripted full-page scroll at 4x CPU throttling it held the same median
     and 95th-percentile frame time either way, but produced 2-3 frames over
     20ms per scroll against none without it, on every run. Small, but it
     buys only a ramp that the background-colour and shadow transitions
     already cover. It costs no LCP either way — measured, no difference.

     Do NOT move this onto a pseudo-element that fades in with `opacity` —
     an element with opacity forms a backdrop root, and the filter then has
     nothing behind it to sample, so the glass silently renders as a flat
     translucent panel. Measured that way round too.

     The -webkit- spelling lives in its own @supports rule on purpose. Written
     as a second declaration in the same rule — which is how this file had it —
     the build collapses the pair to whichever came last and drops the other,
     so only -webkit-backdrop-filter shipped and Chrome and Firefox, which need
     the unprefixed property, rendered no blur at all. Safari below 18 knows
     only the -webkit- one, so both spellings have to survive minification.
     Check `grep backdrop-filter dist/_astro/*.css` after touching either. */
  #site-header {
    padding-top: env(safe-area-inset-top, 0px);
    background-color: transparent;
    transition:
      background-color 350ms var(--ease-out),
      box-shadow 350ms var(--ease-out);
  }
  #site-header.is-scrolled {
    background-color: color-mix(in srgb, var(--color-neutral-50) 82%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    box-shadow:
      inset 0 1px 0 0 rgb(255 255 255 / 0.6),
      0 1px 32px -8px rgb(0 0 0 / 0.08);
  }
  @supports (-webkit-backdrop-filter: blur(1px)) {
    #site-header.is-scrolled {
      -webkit-backdrop-filter: blur(20px) saturate(180%);
    }
  }

  /* ── Active section ──
     Driven by the scroll-spy observer below, which sets data-current +
     aria-current on the matching link in both navs. */
  #site-header nav a::after {
    content: '';
    position: absolute;
    inset-inline: 1.25rem; /* matches the links' px-5 */
    bottom: 0.25rem;
    height: 2px;
    border-radius: 2px;
    background-color: currentColor;
    transform: scaleX(0);
    transition: transform 250ms var(--ease-out);
  }
  #site-header nav a[data-current] {
    color: var(--color-teal-700); /* 7.46:1 on warm white ✅ */
  }
  #site-header nav a[data-current]::after {
    transform: scaleX(1);
  }
  #mobile-menu nav a[data-current] {
    color: var(--color-teal-700); /* 7.19:1 on teal-50 ✅ */
    background-color: var(--color-teal-50);
  }

  /* ── Mobile menu overlay — animated entrance/exit ── */
  #mobile-menu {
    display: flex;
    flex-direction: column;
    position: fixed;
    inset: 0;
    /* Above the header (z-50), not below it. At z-40 the header painted over
       this overlay's own top bar, so its close button and logo rendered zero
       pixels — verified by hiding the bar and getting a byte-identical shot —
       while the header showed a second, differently-sized copy of both. */
    z-index: 60;
    padding-top: env(safe-area-inset-top, 0px);
    /* Opaque, with no backdrop-filter. At 98% the blur measured 5/255 against
       the page behind it — invisible — while still costing a full-screen
       composited blur for the length of the open animation, which is one of
       the more expensive things to ask of a low-end phone. Either commit to
       glass at ~80% and let it read, or drop it; this drops it.

       The warm top is not decoration. The header is transparent at rest, so
       at the top of the page it shows the hero's wash, measured #fef2e9. A
       flat neutral-50 panel replaced that with #fdfbf7 the moment the menu
       opened, and the top bar visibly cooled even though it is meant to read
       as the same header. teal-100 at 50% over neutral-50 computes to
       #fef2ea, which is that wash, so the bar does not change colour when the
       menu opens. It resolves to neutral-50 by 60% down, because that is the
       page's real background everywhere below the hero, and the menu can be
       opened from any scroll position. teal-50 is the wrong token here: it is
       pink (#fff5f1) where the hero is amber. */
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-teal-100) 50%, var(--color-neutral-50)) 0%,
      var(--color-neutral-50) 60%
    );

    /* Fades, and does not move. It used to open with
       translateY(-10px) scale(0.985), and the reason for dropping that is
       visual, not performance: a ten-run A/B found no frame-timing
       difference either way, so do not re-add it expecting one back.

       The overlay fades in over the header, which stays put underneath at
       full opacity for the length of the fade. This bar is aligned pixel for
       pixel with the header and is meant to read as the same header — so
       while it slid up from 10px high and 1.5% small, the header's logo sat
       visible beneath the menu's own logo, slightly offset, for the whole
       300ms. Two near-identical logos drifting past each other. Chrome that
       is meant to stay put should not slide. */
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 300ms var(--ease-drawer),
      visibility 0ms linear 300ms;
  }
  #mobile-menu[data-open='true'] {
    visibility: visible;
    opacity: 1;
    transition:
      opacity 300ms var(--ease-drawer),
      visibility 0ms linear 0ms;
  }

  /* ── Mobile nav links — staggered entrance ── */
  #mobile-menu nav a {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
    transition-delay: 0ms; /* exit: disappear together with the overlay, no stagger */
  }
  #mobile-menu[data-open='true'] nav a {
    opacity: 1;
    transform: translateY(0);
  }
  #mobile-menu[data-open='true'] nav a:nth-child(1) {
    transition-delay: 80ms;
  }
  #mobile-menu[data-open='true'] nav a:nth-child(2) {
    transition-delay: 120ms;
  }
  #mobile-menu[data-open='true'] nav a:nth-child(3) {
    transition-delay: 160ms;
  }
  #mobile-menu[data-open='true'] nav a:nth-child(4) {
    transition-delay: 200ms;
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header,
    #site-header nav a::after {
      transition: none !important;
    }
    #mobile-menu {
      transition: none !important;
      transform: none !important;
    }
    #mobile-menu nav a {
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('nav-toggle')!;
  const closeBtn = document.getElementById('nav-close-btn')!;
  const menu = document.getElementById('mobile-menu')!;

  // Inert everything at the top level except the dialog itself. Naming the
  // elements individually kept leaking: `querySelector('footer')` matched the
  // sr-only <footer> inside Quote's blockquote rather than the site footer, and
  // the sticky mobile action bar is a body child too, so Tab walked straight out
  // of an aria-modal dialog. This also covers anything added beside them later.
  const backdropEls = () =>
    [...document.body.children].filter(
      (el) => el !== menu && el.tagName !== 'SCRIPT'
    ) as HTMLElement[];

  // ── Scroll → frosted glass ──
  // rAF-guarded so a fast scroll on a low-end phone queues at most one class
  // write per frame instead of one per scroll event.
  const onScroll: (() => void)[] = [
    () => header.classList.toggle('is-scrolled', window.scrollY > 20),
  ];
  let ticking = false;
  const runScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      onScroll.forEach((fn) => fn());
      ticking = false;
    });
  };
  window.addEventListener('scroll', runScroll, { passive: true });
  window.addEventListener('resize', runScroll, { passive: true });
  onScroll[0]();

  // ── Scroll lock ──
  // `overflow: hidden` on <body> does not stop background scrolling in iOS
  // Safari; pinning the body with position:fixed does. That drops the page to
  // the top, so the offset is stashed and restored on unlock.
  let lockedAt = 0;
  const lockScroll = () => {
    lockedAt = window.scrollY;
    document.body.style.position = 'fixed';
    document.body.style.top = `-${lockedAt}px`;
    document.body.style.insetInline = '0';
    document.body.style.overflow = 'hidden';
  };
  const unlockScroll = () => {
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.insetInline = '';
    document.body.style.overflow = '';
    // 'instant' matters: :root has scroll-behavior:smooth, so a plain
    // scrollTo would animate the restore and fight the anchor jump that
    // follows when the menu was closed by tapping a link.
    window.scrollTo({ top: lockedAt, behavior: 'instant' });
  };

  // ── Menu helpers ──
  const openMenu = () => {
    menu.dataset.open = 'true';
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'סגור תפריט ניווט');
    // The close button, not `menu.querySelector('a')` — that matched the logo
    // link, so opening the nav ringed a link back to the current page. It only
    // looked harmless while the header was painting over this whole bar.
    closeBtn.focus();
    // Everything above is cheap. Pinning <body> relayouts the whole document
    // and inert touches every top-level element, and both used to land on the
    // opening frame, which is the one frame that has to be smooth. Deferring
    // them by a frame lets the fade start first.
    requestAnimationFrame(() => {
      lockScroll();
      backdropEls().forEach((el) => el.setAttribute('inert', ''));
    });
  };

  const closeMenu = () => {
    menu.dataset.open = 'false';
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'פתח תפריט ניווט');
    unlockScroll();
    // Un-inert before focusing: the toggle lives inside the header, which is
    // itself inert while the menu is open.
    backdropEls().forEach((el) => el.removeAttribute('inert'));
    toggle.focus();
  };

  toggle.addEventListener('click', () => (menu.dataset.open === 'true' ? closeMenu() : openMenu()));
  closeBtn.addEventListener('click', closeMenu);
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  document.getElementById('nav-cal-btn')?.addEventListener('click', closeMenu);
  document.addEventListener('keydown', (e) => {
    // Only when the menu is actually open — otherwise Escape anywhere on the page
    // (e.g. while typing in the contact form) would yank focus to the toggle.
    if (e.key === 'Escape' && menu.dataset.open === 'true') closeMenu();
  });

  // ── Scroll spy: mark the section the reader is actually in ──
  const sectionLinks = [
    ...document.querySelectorAll<HTMLAnchorElement>(
      '#site-header nav a[href^="#"], #mobile-menu nav a[href^="#"]'
    ),
  ];
  // Document order, not link order — the nav lists אודות before שירותים while
  // the page puts #services first, and the spy has to pick the topmost match.
  const spied = [...new Set(sectionLinks.map((a) => a.hash.slice(1)))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null)
    .sort((a, b) => a.offsetTop - b.offsetTop);

  if (spied.length) {
    let currentId = '';
    const paint = (next: string) => {
      if (next === currentId) return;
      currentId = next;
      sectionLinks.forEach((a) => {
        const on = a.hash.slice(1) === next;
        a.toggleAttribute('data-current', on);
        if (on) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    };

    // The last section whose top has crossed a line 45% down the viewport.
    // An IntersectionObserver over a narrow band was tried first and left
    // gaps: with a 5%-tall band, the margin between two sections can sit in
    // it with neither one intersecting, so #testimonials never lit up and
    // the marker went blank at the foot of the page. Asking "which section
    // have I scrolled past" always has exactly one answer, and it keeps the
    // last section marked while the footer is on screen.
    const pick = () => {
      const line = window.innerHeight * 0.45;
      let next = '';
      for (const el of spied) if (el.getBoundingClientRect().top <= line) next = el.id;
      paint(next);
    };
    onScroll.push(pick);
    pick();
  }
</script>

---
// Real reviews, copied verbatim from the clinic's Google Business Profile
// (5.0 avg, 6 reviews as of 2026-09). Only fields with real source data are
// kept — no invented role/location. `postedOn` is a fixed "Month Year" string
// (when it was actually posted), not a relative "X months ago" — it never
// needs updating and is never wrong.
interface Testimonial {
  id: number;
  text: string;
  author: string;
  initials: string;
  service: string;
  postedOn: string;
}

const testimonials: Testimonial[] = [
  {
    id: 1,
    text: 'אני רוצה להודות מכל הלב לגל עופרי, פיזיותרפיסטית מקצועית, מסורה ואכפתית ברמה יוצאת דופן. הגעתי אליה עם קרע בגיד אכילס, מצב לא פשוט שדרש טיפול מדויק, סבלנות והתמדה. היא ליוותה אותי לאורך כל הדרך במסירות רבה, רגישות וידע מקצועי מרשים. בזכות היחס האישי, ההכוונה המדויקת וההשקעה האמיתית שלה, הצלחתי להשתקם ולהחלים בצורה הטובה ביותר. ממליצה עליה בחום לכל מי שזקוק לטיפול פיזיותרפי ברמה הגבוהה ביותר, לא רק מקצועית, אלא גם אנושית. תודה רבה לך גל על הכל! 🙏',
    author: 'שמחה מ.',
    initials: 'שמ',
    service: 'שיקום אורתופדי',
    postedOn: 'מאי 2026',
  },
  {
    id: 2,
    text: 'פיזיותרפיסטית מקצועית, מסורה ובעלת ידע רחב. כבר מהמפגש הראשון הרגשתי שאני בידיים טובות – מקשיבה, מסבירה בסבלנות ובונה תוכנית טיפול מותאמת אישית. לאורך כל הדרך גל הייתה קשובה, אכפתית ומעודדת, והטיפולים הביאו לשיפור משמעותי בכאבים ובתפקוד. ממליץ בחום לכל מי שמחפש פיזיותרפיסטית רצינית, נעימה ויעילה באמת',
    author: 'ראם ב.',
    initials: 'רב',
    service: 'טיפול בכאב',
    postedOn: 'דצמבר 2025',
  },
  {
    id: 3,
    text: 'אלופה !! שירות מדהים, עזרה לי ממש בפציעת סקי שסחבתי הרבה זמן, מקצוענית עם יחס אישי מאוד טוב. ממליצה מאוד!!!!',
    author: 'יובל ב.',
    initials: 'יב',
    service: 'שיקום ספורט',
    postedOn: 'מאי 2026',
  },
];
---

<section id="testimonials" aria-labelledby="testimonials-heading" class="section-padding bg-white">
  <div class="container-prose">
    <!-- Section header -->
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold tracking-wide text-teal-600">מה אומרים המטופלים</p>
      <h2
        id="testimonials-heading"
        class="font-heading mt-3 text-3xl font-bold text-teal-700 md:text-4xl"
      >
        מטופלים מספרים
      </h2>
      <p class="mt-4 leading-relaxed text-neutral-600">
        לכל אחד ואחת יש את הקצב והדרך שלהם. הנה כמה רגעים מהתהליכים שעברנו יחד.
      </p>
      <a
        href="https://www.google.com/search?kgmid=/g/11ynf97pzh"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center gap-1.5 py-1.5 text-sm font-medium text-teal-700 underline-offset-2 transition-colors hover:text-teal-800 hover:underline"
      >
        ראו עוד ביקורות ב-Google
      </a>
    </div>

    <!-- Testimonial cards: horizontal snap carousel on mobile (one card + a peek of
         the next, keeps the section from dominating the scroll), plain 3-col grid
         from md up where there's no vertical-space problem to solve. -->
    <div
      class="stagger-children mt-14 overflow-x-auto overscroll-x-contain pb-2 [scrollbar-width:none] md:overflow-visible [&::-webkit-scrollbar]:hidden"
      role="group"
      tabindex="0"
      aria-label="המלצות מטופלים, גללו לצפייה בעוד המלצות"
    >
      <div
        class="flex snap-x snap-mandatory gap-5 md:grid md:snap-none md:grid-cols-3 md:gap-6"
        role="list"
        aria-label="המלצות מטופלים"
      >
        {
          testimonials.map((t) => (
            <article
              id={`testimonial-card-${t.id}`}
              role="listitem"
              class="group hover:shadow-card-hover flex w-[82%] shrink-0 snap-start flex-col rounded-3xl bg-neutral-50 p-9 ring-1 ring-neutral-100 transition-[transform,box-shadow] duration-300 hover:-translate-y-1.5 hover:ring-teal-100 sm:w-[60%] md:w-auto md:shrink"
              aria-label={`המלצה מ-${t.author}`}
            >
              {/* Rating — every one of these Google reviews is 5 stars */}
              <div class="flex items-center gap-0.5" role="img" aria-label="דירוג: 5 מתוך 5 כוכבים">
                {[0, 1, 2, 3, 4].map(() => (
                  <svg
                    class="text-rating h-4 w-4"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L10 14.78l-5.2 2.73.99-5.79-4.21-4.1 5.82-.85L10 1.5z" />
                  </svg>
                ))}
              </div>

              {/* Blockquote */}
              <blockquote class="mt-4 flex-1">
                {/* Decorative opening quote mark */}
                <svg
                  aria-hidden="true"
                  class="mb-3 h-6 w-6 text-teal-200 transition-colors duration-300 group-hover:text-teal-300"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                </svg>
                <div class="relative">
                  <p
                    class="quote-scroll h-44 overflow-y-auto pe-2 text-sm leading-relaxed text-neutral-600 md:h-32"
                    role="group"
                    tabindex="0"
                    aria-label="טקסט ההמלצה, ניתן לגלילה"
                  >
                    {t.text}
                  </p>
                  <div
                    class="quote-fade pointer-events-none absolute inset-x-0 bottom-0 hidden h-7 bg-gradient-to-t from-neutral-50 to-transparent"
                    aria-hidden="true"
                  />
                </div>
              </blockquote>

              {/* Divider */}
              <div aria-hidden="true" class="my-6 h-px bg-neutral-200/70" />

              {/* Author */}
              <footer class="flex items-center gap-3">
                {/* Avatar with initials */}
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-teal-100 text-sm font-bold text-teal-700"
                  aria-hidden="true"
                >
                  {t.initials}
                </div>
                <div class="min-w-0">
                  <cite class="block text-sm font-semibold text-neutral-800 not-italic">
                    {t.author}
                  </cite>
                  <p class="text-xs text-neutral-600">{t.postedOn} · Google</p>
                </div>
                {/* Service tag */}
                <span class="ms-auto shrink-0 rounded-full bg-teal-100 px-2.5 py-1 text-xs font-medium text-teal-700">
                  <span class="sr-only">שירות: </span>
                  {t.service}
                </span>
              </footer>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Pagination dots — mobile carousel only, synced to the visible card -->
    <div class="mt-5 flex justify-center gap-2 md:hidden" aria-hidden="true">
      {
        testimonials.map((t) => (
          <span
            class="testimonial-dot h-2 w-2 rounded-full bg-neutral-500 transition-colors duration-200"
            data-dot-for={`testimonial-card-${t.id}`}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .quote-scroll {
    scrollbar-width: thin;
    scrollbar-color: var(--color-teal-200) transparent;
  }
  .quote-scroll::-webkit-scrollbar {
    width: 4px;
  }
  .quote-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .quote-scroll::-webkit-scrollbar-thumb {
    background-color: var(--color-teal-200);
    border-radius: 9999px;
  }
  .testimonial-dot[data-active='true'] {
    background-color: var(--color-teal-600);
    width: 1.25rem;
  }
</style>

<script>
  const track = document.querySelector('#testimonials [role="group"]') as HTMLElement | null;
  const dots = document.querySelectorAll<HTMLElement>('.testimonial-dot');
  if (track && dots.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const dot = document.querySelector<HTMLElement>(
            `.testimonial-dot[data-dot-for="${entry.target.id}"]`
          );
          if (dot) dot.dataset.active = entry.isIntersecting ? 'true' : 'false';
        });
      },
      { root: track, threshold: 0.6 }
    );
    document.querySelectorAll('#testimonials article[id^="testimonial-card-"]').forEach((el) => {
      observer.observe(el);
    });
  }

  // Fade hint: only shown when a card's quote is actually clipped (desktop's
  // fixed-height cards), and hidden again once scrolled to the real bottom —
  // native scrollbars aren't reliably visible enough on their own (OS/browser
  // dependent) to signal there's more to read.
  document.querySelectorAll<HTMLElement>('.quote-scroll').forEach((el) => {
    const fade = el.nextElementSibling as HTMLElement | null;
    if (!fade) return;
    const sync = () => {
      const hasMore = el.scrollHeight - el.clientHeight - el.scrollTop > 2;
      fade.classList.toggle('hidden', !hasMore);
    };
    sync();
    el.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
  });
</script>

---
// Real reviews, copied verbatim from the clinic's Google Business Profile
// (5.0 avg, 6 reviews as of 2026-09). Only fields with real source data are
// kept — no invented role/location. `postedOn` is a fixed "Month Year" string
// (when it was actually posted), not a relative "X months ago" — it never
// needs updating and is never wrong.
interface Testimonial {
  id: number;
  text: string;
  author: string;
  initials: string;
  service: string;
  postedOn: string;
}

const testimonials: Testimonial[] = [
  {
    id: 1,
    text: 'אני רוצה להודות מכל הלב לגל עופרי, פיזיותרפיסטית מקצועית, מסורה ואכפתית ברמה יוצאת דופן. הגעתי אליה עם קרע בגיד אכילס, מצב לא פשוט שדרש טיפול מדויק, סבלנות והתמדה. היא ליוותה אותי לאורך כל הדרך במסירות רבה, רגישות וידע מקצועי מרשים. בזכות היחס האישי, ההכוונה המדויקת וההשקעה האמיתית שלה, הצלחתי להשתקם ולהחלים בצורה הטובה ביותר. ממליצה עליה בחום לכל מי שזקוק לטיפול פיזיותרפי ברמה הגבוהה ביותר, לא רק מקצועית, אלא גם אנושית. תודה רבה לך גל על הכל! 🙏',
    author: 'שמחה מ.',
    initials: 'שמ',
    service: 'שיקום אורתופדי',
    postedOn: 'מאי 2026',
  },
  {
    id: 2,
    text: 'פיזיותרפיסטית מקצועית, מסורה ובעלת ידע רחב. כבר מהמפגש הראשון הרגשתי שאני בידיים טובות – מקשיבה, מסבירה בסבלנות ובונה תוכנית טיפול מותאמת אישית. לאורך כל הדרך גל הייתה קשובה, אכפתית ומעודדת, והטיפולים הביאו לשיפור משמעותי בכאבים ובתפקוד. ממליץ בחום לכל מי שמחפש פיזיותרפיסטית רצינית, נעימה ויעילה באמת',
    author: 'ראם ב.',
    initials: 'רב',
    service: 'טיפול בכאב',
    postedOn: 'דצמבר 2025',
  },
  {
    id: 3,
    text: 'אלופה !! שירות מדהים, עזרה לי ממש בפציעת סקי שסחבתי הרבה זמן, מקצוענית עם יחס אישי מאוד טוב. ממליצה מאוד!!!!',
    author: 'יובל ב.',
    initials: 'יב',
    service: 'שיקום ספורט',
    postedOn: 'מאי 2026',
  },
];
---

<section id="testimonials" aria-labelledby="testimonials-heading" class="section-padding bg-white">
  <div class="container-prose">
    <!-- Section header -->
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold tracking-wide text-teal-600" aria-hidden="true">
        מה אומרים המטופלים
      </p>
      <h2
        id="testimonials-heading"
        class="mt-3 font-serif text-3xl font-bold text-teal-700 md:text-4xl"
      >
        מטופלים מספרים
      </h2>
      <p class="mt-4 leading-relaxed text-neutral-600">
        לכל אחד ואחת יש את הקצב והדרך שלהם. הנה כמה רגעים מהתהליכים שעברנו יחד.
      </p>
    </div>

    <!-- Testimonial cards: horizontal snap carousel on mobile (one card + a peek of
         the next, keeps the section from dominating the scroll), plain 3-col grid
         from md up where there's no vertical-space problem to solve. -->
    <div
      class="stagger-children mt-14 overflow-x-auto overscroll-x-contain pb-2 [scrollbar-width:none] md:overflow-visible [&::-webkit-scrollbar]:hidden"
      role="group"
      tabindex="0"
      aria-label="המלצות מטופלים, גללו לצפייה בעוד המלצות"
    >
      <div
        class="flex snap-x snap-mandatory gap-5 md:grid md:snap-none md:grid-cols-3 md:gap-6"
        role="list"
        aria-label="המלצות מטופלים"
      >
        {
          testimonials.map((t) => (
            <article
              role="listitem"
              class="group hover:shadow-card-hover flex w-[82%] shrink-0 snap-start flex-col rounded-3xl bg-neutral-50 p-9 ring-1 ring-neutral-100 transition-[transform,box-shadow] duration-300 hover:-translate-y-1.5 hover:ring-teal-100 sm:w-[60%] md:w-auto md:shrink"
              aria-label={`המלצה מ-${t.author}`}
            >
              {/* Blockquote */}
              <blockquote class="mt-5 flex-1">
                {/* Decorative opening quote mark */}
                <svg
                  aria-hidden="true"
                  class="text-accent-gold/60 group-hover:text-accent-gold/80 mb-3 h-6 w-6 transition-colors duration-300"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                </svg>
                <p class="line-clamp-6 text-sm leading-relaxed text-neutral-600">{t.text}</p>
              </blockquote>

              {/* Divider */}
              <div aria-hidden="true" class="my-6 h-px bg-neutral-200/70" />

              {/* Author */}
              <footer class="flex items-center gap-3">
                {/* Avatar with initials */}
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-teal-100 text-sm font-bold text-teal-700"
                  aria-hidden="true"
                >
                  {t.initials}
                </div>
                <div class="min-w-0">
                  <cite class="block text-sm font-semibold text-neutral-800 not-italic">
                    {t.author}
                  </cite>
                  <p class="text-xs text-neutral-600">{t.postedOn} · Google</p>
                </div>
                {/* Service tag */}
                <span
                  class="ms-auto shrink-0 rounded-full bg-teal-100 px-2.5 py-1 text-xs font-medium text-teal-700"
                  aria-label={`שירות: ${t.service}`}
                >
                  {t.service}
                </span>
              </footer>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

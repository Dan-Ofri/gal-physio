---
// Real reviews, copied verbatim from the clinic's Google Business Profile
// (5.0 avg, 6 reviews as of 2026-09). Only fields with real source data are
// kept — no invented role/location. `postedOn` is a fixed "Month Year" string
// (when it was actually posted), not a relative "X months ago" — it never
// needs updating and is never wrong.
interface Testimonial {
  id: number;
  text: string;
  author: string;
  initials: string;
  service: string;
  postedOn: string;
}

const testimonials: Testimonial[] = [
  {
    id: 1,
    text: 'אני רוצה להודות מכל הלב לגל עופרי, פיזיותרפיסטית מקצועית, מסורה ואכפתית ברמה יוצאת דופן. הגעתי אליה עם קרע בגיד אכילס, מצב לא פשוט שדרש טיפול מדויק, סבלנות והתמדה. היא ליוותה אותי לאורך כל הדרך במסירות רבה, רגישות וידע מקצועי מרשים. בזכות היחס האישי, ההכוונה המדויקת וההשקעה האמיתית שלה, הצלחתי להשתקם ולהחלים בצורה הטובה ביותר. ממליצה עליה בחום לכל מי שזקוק לטיפול פיזיותרפי ברמה הגבוהה ביותר, לא רק מקצועית, אלא גם אנושית. תודה רבה לך גל על הכל! 🙏',
    author: 'שמחה מ.',
    initials: 'שמ',
    service: 'שיקום אורתופדי',
    postedOn: 'מאי 2026',
  },
  {
    id: 2,
    text: 'פיזיותרפיסטית מקצועית, מסורה ובעלת ידע רחב. כבר מהמפגש הראשון הרגשתי שאני בידיים טובות – מקשיבה, מסבירה בסבלנות ובונה תוכנית טיפול מותאמת אישית. לאורך כל הדרך גל הייתה קשובה, אכפתית ומעודדת, והטיפולים הביאו לשיפור משמעותי בכאבים ובתפקוד. ממליץ בחום לכל מי שמחפש פיזיותרפיסטית רצינית, נעימה ויעילה באמת',
    author: 'ראם ב.',
    initials: 'רב',
    service: 'טיפול בכאב',
    postedOn: 'דצמבר 2025',
  },
  {
    id: 3,
    text: 'אלופה !! שירות מדהים, עזרה לי ממש בפציעת סקי שסחבתי הרבה זמן, מקצוענית עם יחס אישי מאוד טוב. ממליצה מאוד!!!!',
    author: 'יובל ב.',
    initials: 'יב',
    service: 'שיקום ספורט',
    postedOn: 'מאי 2026',
  },
];
---

<section
  id="testimonials"
  aria-labelledby="testimonials-heading"
  class="section-padding relative bg-white"
>
  <!--
    relative + content at z-10: the house pattern, see Hero/Services/Quote/Contact.
    A section left at position:static has its content painted in the in-flow
    phase, which the whole of every POSITIONED sibling paints on top of - so
    Hero's blur(120px) disc and Services' blur(64px) disc, neither of which is
    clipped on the block axis, were landing over this section's text. Being
    positioned puts this section in the same paint phase as the others, and
    z-10 on the content lifts it over any halo, which all sit at z-auto.
  -->
  <div class="container-prose relative z-10">
    <!-- Section header -->
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow text-xs font-semibold tracking-wide text-teal-600">מה אומרים המטופלים</p>
      <h2
        id="testimonials-heading"
        class="font-heading heading-rule mt-3 text-3xl font-bold text-teal-700 md:text-4xl"
      >
        מטופלים מספרים
      </h2>
      <p class="mt-4 leading-relaxed text-balance text-neutral-600">
        לכל אחד ואחת יש את הקצב והדרך שלהם. הנה כמה רגעים מהתהליכים שעברנו יחד.
      </p>
      <a
        href="https://www.google.com/search?kgmid=/g/11ynf97pzh"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center gap-1.5 py-1.5 text-sm font-medium text-teal-700 underline underline-offset-2 transition-colors hover:text-teal-800"
      >
        ראו עוד ביקורות ב-Google
      </a>
    </div>

    <!-- Testimonial cards: horizontal snap carousel on mobile (one card + a peek of
         the next, keeps the section from dominating the scroll), plain 3-col grid
         from md up where there's no vertical-space problem to solve.

         `contain-paint` is load-bearing, not an optimisation. Without it this
         scroller's clipped content still counts towards <html>'s scrollable
         overflow, so the whole document became 801px wide at a 390px viewport and
         the page could be swiped sideways into a blank screen — verified in both
         Chromium and WebKit, so it hit iOS too. Every ancestor reports the correct
         390px; only the root gets it wrong, and `overflow-x: hidden` on html/body
         does NOT fix it (tested). Paint containment is the only thing that does.
         It changes nothing visually here because `overflow-x-auto` already clips
         on both axes — but it must stay off at md, where the scroller turns into a
         plain grid and cards need to paint their hover lift and shadow outside it. -->
    <div
      class="stagger-children mt-14 overflow-x-auto overscroll-x-contain pb-2 contain-paint [scrollbar-width:none] lg:overflow-visible lg:contain-none [&::-webkit-scrollbar]:hidden"
      role="group"
      tabindex="0"
      aria-label="המלצות מטופלים, גללו לצפייה בעוד המלצות"
    >
      <div
        class="flex snap-x snap-mandatory gap-5 lg:grid lg:snap-none lg:grid-cols-3 lg:gap-6"
        role="list"
        aria-label="המלצות מטופלים"
      >
        {
          testimonials.map((t) => (
            <div
              id={`testimonial-card-${t.id}`}
              role="listitem"
              class="group hover:shadow-card-hover flex w-[82%] shrink-0 snap-start flex-col rounded-3xl bg-neutral-50 p-9 ring-1 ring-neutral-100 transition-[transform,box-shadow] duration-300 hover:-translate-y-1.5 hover:ring-teal-100 sm:w-[60%] lg:w-auto lg:shrink"
              aria-label={`המלצה מ-${t.author}`}
            >
              {/* No star row. The reviews are all 5 stars on Google, but rendering
                  that as five hardcoded stars per card is a claim the markup cannot
                  keep true — paste in a 4-star review verbatim and the card would
                  still show five. The verbatim text, the real name, the date, the
                  "Google" byline and the link out to the profile are all stronger
                  signals anyway, and a visitor can check them. */}

              {/* Blockquote */}
              <blockquote class="flex-1">
                {/* Decorative opening quote mark */}
                <svg
                  aria-hidden="true"
                  class="mb-3 h-6 w-6 text-teal-200 transition-colors duration-300 group-hover:text-teal-300"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                </svg>
                <div class="relative">
                  {/* Clamped at every width. From lg up the three cards share a
                      grid row and have to agree on a height; below that the
                      longest review ran to ~20 lines in a 320px card and the
                      testimonials section alone took over a screen and a half of
                      vertical scroll on a phone, which is what the clamp is back
                      to fix.

                      Two things keep the nested scroll from being the trap it was
                      the last time this was tried. The mobile box is h-44, not
                      desktop's h-32 — there is one card on screen, so it can
                      afford ~8 lines and most of the shorter reviews fit whole
                      with no scroll at all. And overscroll behaviour is left at
                      `auto` on purpose: reaching the end of a quote chains
                      straight into page scroll instead of swallowing the swipe.
                      Do not add `overscroll-contain` here — it would stop exactly
                      the chaining that makes this tolerable on a touchscreen.

                      The fade below signals the clipping; role/tabindex/aria-label
                      are attached by the script, and only while the box can
                      actually scroll. */}
                  <p class="quote-scroll h-44 overflow-y-auto pe-2 text-sm leading-relaxed text-neutral-600 lg:h-32">
                    {t.text}
                  </p>
                  <div
                    class="quote-fade pointer-events-none absolute inset-x-0 bottom-0 hidden h-7 bg-gradient-to-t from-neutral-50 to-transparent"
                    aria-hidden="true"
                  />
                </div>
              </blockquote>

              {/* Divider */}
              <div aria-hidden="true" class="my-6 h-px bg-neutral-200/70" />

              {/* Author */}
              {/* flex-wrap, not a plain row: the name block cannot shrink past
                  its longest word ("Google"), and the pill is shrink-0, so at
                  the md grid's column width the three together needed ~209px of
                  a 158px card and the pill printed straight over the date.
                  Wrapping drops the pill to its own line instead; there is room
                  for one row from lg up, so nothing moves there. */}
              <footer class="flex flex-wrap items-center gap-3">
                {/* Avatar and name are one unbreakable unit. Wrapping them as
                    three loose flex items instead let the avatar orphan onto a
                    row of its own whenever the date happened to be a little
                    wider - "דצמבר 2025" did it and "מאי 2026" did not - which
                    read as a broken card rather than a tight one. */}
                {/* No min-w-0 anywhere in here: it lets the group collapse past its
                      own content instead of wrapping, which puts the pill back
                      on top of the date. Default min-width:auto is what makes
                      the line break happen at the right moment. */}
                <div class="flex items-center gap-3">
                  {/* Avatar with initials */}
                  <div
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-teal-100 text-sm font-bold text-teal-700"
                    aria-hidden="true"
                  >
                    {t.initials}
                  </div>
                  <div>
                    <cite class="block text-sm font-semibold text-neutral-800 not-italic">
                      {t.author}
                    </cite>
                    <p class="text-xs text-neutral-600">{t.postedOn} · Google</p>
                  </div>
                </div>
                {/* Service tag */}
                <span class="ms-auto shrink-0 rounded-full bg-teal-100 px-2.5 py-1 text-xs font-medium text-teal-700">
                  <span class="sr-only">שירות: </span>
                  {t.service}
                </span>
              </footer>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Pagination dots — mobile carousel only, synced to the visible card -->
    <div class="mt-5 flex justify-center gap-2 lg:hidden" aria-hidden="true">
      {
        testimonials.map((t) => (
          <span
            class="testimonial-dot h-2 w-2 rounded-full bg-neutral-500 transition-colors duration-200"
            data-dot-for={`testimonial-card-${t.id}`}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .quote-scroll {
    scrollbar-width: thin;
    scrollbar-color: var(--color-teal-200) transparent;
  }
  .quote-scroll::-webkit-scrollbar {
    width: 4px;
  }
  .quote-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .quote-scroll::-webkit-scrollbar-thumb {
    background-color: var(--color-teal-200);
    border-radius: 9999px;
  }
  .testimonial-dot[data-active='true'] {
    background-color: var(--color-teal-600);
    width: 1.25rem;
  }
</style>

<script>
  const track = document.querySelector('#testimonials [role="group"]') as HTMLElement | null;
  const dots = document.querySelectorAll<HTMLElement>('.testimonial-dot');
  if (track && dots.length) {
    // One dot lights at a time, and it is the card that is *most* on screen.
    // Marking every entry that passes a threshold looked right while exactly
    // one card fitted, but the carousel now runs up to lg, where two cards are
    // over 60% visible at once and two dots lit together — an indicator that
    // says "you are here, and also here". Ratios are kept per card and the
    // largest wins, so there is always exactly one answer.
    const ratios = new Map<string, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => ratios.set(entry.target.id, entry.intersectionRatio));
        let best = '';
        let bestRatio = 0;
        ratios.forEach((r, id) => {
          if (r > bestRatio) {
            bestRatio = r;
            best = id;
          }
        });
        dots.forEach((dot) => {
          dot.dataset.active = dot.dataset.dotFor === best ? 'true' : 'false';
        });
      },
      // A spread of thresholds, not one: the callback only fires when a
      // threshold is crossed, so with a single value the ratios map goes stale
      // between crossings and the wrong card can hold the marker.
      { root: track, threshold: [0, 0.25, 0.5, 0.75, 1] }
    );
    // Matched on the id alone, never on the tag. These cards were <article>
    // until the list roles were fixed and they became <div role="listitem">;
    // an `article[id^=...]` selector then matched nothing, the observer watched
    // nothing, and the dots sat grey and equal-width for every card with no
    // error anywhere. Keep this keyed to the id the markup actually promises.
    document.querySelectorAll('#testimonials [id^="testimonial-card-"]').forEach((el) => {
      observer.observe(el);
    });
  }

  // Fade hint: only shown when a card's quote is actually clipped (desktop's
  // fixed-height cards), and hidden again once scrolled to the real bottom —
  // native scrollbars aren't reliably visible enough on their own (OS/browser
  // dependent) to signal there's more to read.
  document.querySelectorAll<HTMLElement>('.quote-scroll').forEach((el) => {
    const fade = el.nextElementSibling as HTMLElement | null;
    if (!fade) return;
    const sync = () => {
      const canScroll = el.scrollHeight - el.clientHeight > 2;
      const hasMore = el.scrollHeight - el.clientHeight - el.scrollTop > 2;
      fade.classList.toggle('hidden', !hasMore);
      // A scrollable region needs a name and a keyboard way in; a box that
      // fits its text is neither, and leaving the two on would put a focus
      // stop with nothing to do in the middle of every card.
      if (canScroll) {
        el.setAttribute('role', 'group');
        el.setAttribute('tabindex', '0');
        el.setAttribute('aria-label', 'טקסט ההמלצה, ניתן לגלילה');
      } else {
        el.removeAttribute('role');
        el.removeAttribute('tabindex');
        el.removeAttribute('aria-label');
      }
    };
    sync();
    el.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    // Measure again once the real fonts are in. This module runs at parse time,
    // when Assistant has not swapped in yet, so the first sync() measures the
    // fallback face — and the fallback happened to be short enough that all
    // three quotes "fit" their box. Every card therefore came out with no
    // tabindex and no role, and then the swap made two of them scrollable with
    // no keyboard way in: a serious axe `scrollable-region-focusable` failure in
    // WebKit that is invisible in Chromium, where the swap lands before the
    // first measurement often enough to hide it. Cheap and idempotent; sync()
    // sets the same attributes it would have set the first time.
    if (document.fonts) document.fonts.ready.then(sync);
  });
</script>

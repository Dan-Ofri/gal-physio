---
import { Image } from 'astro:assets';
import clinicHero from '../assets/hero-ref.png';
---

<section
  id="hero"
  aria-labelledby="hero-heading"
  class="relative flex min-h-svh items-center overflow-hidden bg-neutral-50 pt-14 md:pt-6"
>
  <!-- Subtle warm glow — very low opacity, clinical feel -->
  <div
    aria-hidden="true"
    class="hero-glow-layer pointer-events-none absolute inset-0 overflow-hidden select-none"
  >
    <div
      class="absolute -end-40 -top-32 h-[640px] w-[640px] rounded-full bg-teal-100/50 blur-[140px]"
    >
    </div>
    <div
      class="absolute -start-24 -bottom-48 h-[480px] w-[480px] rounded-full bg-teal-50/70 blur-[120px]"
    >
    </div>
  </div>

  <!-- ── Content grid ── -->
  <div
    class="container-prose relative z-10 grid items-center gap-8 py-10 pb-14 lg:grid-cols-2 lg:gap-20 lg:py-16"
  >
    <!-- Text (first in DOM = right column in RTL desktop, top in mobile) -->
    <div class="flex flex-col text-start">
      <!-- Eyebrow / badge -->
      <p
        class="animate-fade-up mb-4 inline-flex items-center gap-2 self-start text-sm font-medium text-teal-700 [animation-delay:0.04s]"
      >
        <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-teal-600"></span>
        פיזיותרפיסטית מוסמכת (B.P.T)
      </p>

      <!-- H1 — includes "פיזיותרפיה" and "שיקום" keywords -->
      <h1
        id="hero-heading"
        class="animate-fade-up to-brand-amber font-heading w-fit bg-gradient-to-l from-teal-700 bg-clip-text text-4xl leading-[1.15] font-bold text-transparent [animation-delay:0.09s] sm:text-5xl lg:text-[3.25rem]"
      >
        <span class="block">פיזיותרפיה,</span>
        <span class="mt-1 block">תנועה ואיכות חיים</span>
        <span class="sr-only">, שירותי פיזיותרפיה ושיקום</span>
      </h1>

      <!-- Sub-headline -->
      <p
        class="animate-fade-up mt-5 text-start text-base leading-relaxed text-neutral-600 [animation-delay:0.14s] sm:text-lg lg:max-w-lg"
      >
        ליווי אישי בדרך חזרה לתנועה, משיקום פציעות מורכבות ועד שיפור התפקוד היומיומי.
      </p>

      <!-- CTA buttons -->
      <div
        class="animate-fade-up mt-7 flex flex-col items-stretch gap-3 [animation-delay:0.2s] sm:flex-row sm:justify-start"
      >
        <a
          href="#contact"
          class="btn-primary w-full sm:w-auto"
          aria-label="לתיאום ייעוץ ראשוני ופגישה ראשונה עם גל עופרי, פיזיותרפיסטית"
        >
          <svg
            class="h-5 w-5 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-linejoin="round"></rect>
            <path stroke-linecap="round" d="M16 2v4M8 2v4M3 10h18"></path>
          </svg>
          לתיאום ייעוץ ראשוני
        </a>
        <a
          href="#services"
          class="btn-secondary w-full sm:w-auto"
          aria-label="השירותים שלי: שירותי פיזיותרפיה ושיקום"
        >
          השירותים שלי
          <svg
            class="h-4 w-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <polyline points="15 18 9 12 15 6" stroke-linecap="round" stroke-linejoin="round"
            ></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- ── Photo column ── -->
    <div class="flex items-end justify-center lg:justify-end">
      <div class="relative w-full max-w-sm lg:max-w-none">
        <!-- Soft halo behind photo -->
        <div
          aria-hidden="true"
          class="absolute -inset-6 rounded-[2.5rem] bg-gradient-to-br from-teal-100/50 via-teal-50/30 to-transparent blur-lg"
        >
        </div>

        <!-- Photo frame -->
        <figure
          class="shadow-card-hover relative overflow-hidden rounded-3xl ring-1 ring-neutral-200/80"
        >
          <!--
            No height on purpose. Setting both width and height makes Astro's
            sharp service crop to that aspect at build time with fit: cover /
            position: centre, which left the object-[center_18%] below nothing
            to position - the shipped file was already square, so the framing
            was silently centred and her hair grazed the top edge.

            Width only means the full portrait ships and the browser does the
            18% crop, as the class asks. It costs ~28kB on the largest variant,
            which is the deliberate trade while this photo is a placeholder:
            the framing survives swapping in a photo of any dimensions. Once
            the real photo is final and cropped to the display aspect, restore
            height={480} here to get those bytes back.
          -->
          <Image
            src={clinicHero}
            alt="פיזיותרפיסטית עומדת בקליניקה מקצועית ומוארת, תמונת ייחוס עד לצילום של גל עופרי"
            width={480}
            widths={[400, 600, 800, 1100]}
            sizes="(min-width: 1024px) 480px, min(90vw, 384px)"
            loading="eager"
            fetchpriority="high"
            class="block aspect-[4/3] w-full object-cover object-[center_18%] lg:aspect-square"
          />
        </figure>
      </div>
    </div>
  </div>

  <!-- ── Scroll hint ── -->
  <div class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 lg:block" aria-hidden="true">
    <div class="flex flex-col items-center gap-1.5 text-neutral-600">
      <span class="text-xs font-medium">גלול</span>
      <svg
        class="scroll-hint-icon h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <polyline points="6 9 12 15 18 9" stroke-linecap="round" stroke-linejoin="round"></polyline>
      </svg>
    </div>
  </div>
</section>

<style>
  /* The two glow discs are large and heavily blurred, so they wash the whole
     section a few levels warmer than the flat background that follows it: the
     hero's last row measured 254,248,245 against About's 253,251,247. Clipping
     that wash at the section's bottom edge turned the difference into a hard
     full-width line - a 3/255 step, which is small but sits right where the eye
     picks up a discontinuity across a wide flat area.

     Clipping only the inline axis lets the wash carry across the boundary and
     fade out on its own. Measured: step 3 -> 1, and the document stays 390px
     wide, which is the thing that matters here - the sideways-scroll trap in
     "Known issues" is one overflow decision away at all times.

     overflow:clip is Safari 16+. Older WebKit ignores this block and keeps the
     overflow-hidden in the class list, which shows the seam but can never scroll
     the page sideways. That is the right way round to fail. */
  @supports (overflow: clip) {
    #hero,
    #hero > .hero-glow-layer {
      overflow: visible;
      overflow-x: clip;
    }
  }

  /* Smooth exponential drift, not a bounce — real objects don't ricochet. */
  @keyframes scroll-hint-drift {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }
  .scroll-hint-icon {
    animation: scroll-hint-drift 1.8s var(--ease-in-out) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-hint-icon {
      animation: none;
    }
  }
</style>

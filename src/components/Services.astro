---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Oct 2026 shoot, pre-edit: 104A7506, 104A7714, 104A7164.
import orthoImg from '@assets/photos/service-ortho.jpg';
import sportsImg from '@assets/photos/service-sports.jpg';
import preventImg from '@assets/photos/service-preventive.jpg';

interface Service {
  id: string;
  image: ImageMetadata;
  imageAlt: string;
  imagePosition: string;
  title: string;
  description: string;
  // A short aside under the description, marked with the eyebrow dot. Every
  // card has one, so the three end the same way.
  note: string;
}

const services: Service[] = [
  {
    id: 'ortho-rehab',
    image: orthoImg,
    imageAlt: 'גל עופרי מבצעת טיפול ידני בכתף ובשכמה של מטופלת השוכבת על מיטת טיפולים',
    imagePosition: 'object-center',
    title: 'שיקום אורתופדי',
    description:
      'טיפול בכאבי גב, צוואר ומפרקים, וליווי\u00A0מקצועי בתהליכי שיקום לאחר פציעות או\u00A0ניתוחים, לחזרה מלאה ובטוחה לשגרה.',
    // Dry needling is a secondary skill (Gal holds a formal certificate), so
    // it is an aside on this card, not part of the pitch. Her call, Oct 2026.
    note: 'בשילוב דיקור יבש לפי הצורך',
  },
  {
    id: 'sports-rehab',
    image: sportsImg,
    imageAlt: 'גל עופרי מדריכה ספורטאי צעיר בתרגיל סקוואט עם גומיית התנגדות',
    // Tighter on the two of them; centre left both faces small in the card.
    imagePosition: 'object-[center_62%]',
    title: 'שיקום ספורטאים ושיפור ביצועים',
    description:
      'אבחון פציעות ספורט, שיפור טכניקת תנועה ובניית תוכנית חזרה מדורגת לאימונים ולתחרות, תוך מניעת פציעות חוזרות.',
    // This note and the preventive one were added 2026-10-07 so all three
    // cards end alike. Dan's wording, not yet confirmed by Gal.
    note: 'מותאם לכל ענפי הספורט והרמות',
  },
  {
    id: 'preventive',
    image: preventImg,
    imageAlt: 'גל עופרי מנחה מטופל מבוגר בתרגיל ידיים בישיבה על מיטת הטיפולים',
    // His face sits high in this portrait; centre cut it off at the top.
    // An exercise rather than a band on purpose: the sports card already
    // shows a resistance band, and two band photos side by side read as one.
    imagePosition: 'object-[center_40%]',
    title: 'פיזיותרפיה מניעתית ותחזוקת הגוף',
    description:
      'שיפור היציבה, איזון עומסים יומיומיים ובניית חוסן גופני ארוך\u00A0טווח באמצעות\u00A0תרגול מותאם אישית לצרכים שלכם.',
    note: 'כולל הדרכה ודגשים ארגונומיים',
  },
];
---

<section
  id="services"
  aria-labelledby="services-heading"
  class="section-padding clip-inline-only relative overflow-hidden bg-neutral-50"
>
  <!-- Subtle decorative radials -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute end-0 -top-24 h-[480px] w-[480px] rounded-full bg-neutral-100/60 blur-3xl"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute start-0 -bottom-24 h-[320px] w-[320px] rounded-full bg-neutral-100/40 blur-3xl"
  >
  </div>

  <div class="container-prose relative z-10">
    <!-- Section header -->
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow text-xs font-semibold tracking-wide text-teal-600">השירותים שלי</p>
      <h2
        id="services-heading"
        class="font-heading heading-rule mt-3 text-3xl font-bold text-teal-700 md:text-4xl"
      >
        איך אני יכולה לעזור לכם?
      </h2>
      <p class="mt-4 leading-relaxed text-balance text-neutral-600">
        מטיפול בכאב ועד שיקום ספורט. אני&nbsp;כאן לעזור לכם לחזור לנוע בחופשיות, לתפקד ביומיום
        ולהרגיש טוב בגוף שלכם. הטיפולים ניתנים בקליניקה בתל אביב או אצלכם&nbsp;בבית.
      </p>
    </div>

    <!-- Service cards -->
    <div
      class="stagger-children mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3"
      role="list"
      aria-label="שירותי הפיזיותרפיה שלי"
    >
      {
        services.map((service) => (
          <div
            role="listitem"
            class="group row-span-4 grid grid-rows-subgrid gap-y-0 overflow-hidden rounded-2xl bg-white ring-1 ring-neutral-200 transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-0.5 hover:shadow-[0_4px_20px_-4px_rgb(0_0_0_/_0.08)] hover:ring-teal-200/70"
          >
            {/* Photo. An off-centre imagePosition ships without height, so the build
              does not pre-crop it and the class still has excess to position. */}
            <div class="overflow-hidden">
              <Image
                src={service.image}
                alt={service.imageAlt}
                width={480}
                height={service.imagePosition === 'object-center' ? 360 : undefined}
                widths={[400, 600, 800, 1100]}
                sizes="(min-width: 768px) 33vw, 90vw"
                loading="lazy"
                class={`aspect-[4/3] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04] ${service.imagePosition}`}
              />
            </div>

            {/* Text content. Card and text block are subgrids of the list's
                rows (photo, title, description, note), so each row is as tall
                as its tallest member in that visual row of cards: the three
                descriptions start level, and so do the notes. It replaced a
                fixed two-line reserve under every title, which left a blank
                line under each one-line title at widths where nothing wrapped.
                Now the space exists only where a title really wraps (two of
                them at 1024px), and a shorter title sits at the bottom of its
                row, against its own description.
                18px rather than 20px keeps every title on one line at 768,
                1280 and 1440 without renaming a service. */}
            <div class="row-span-3 grid grid-rows-subgrid gap-y-0 p-7">
              <h3 class="font-heading self-end text-lg leading-snug font-bold text-teal-700">
                {service.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-balance text-neutral-600">
                {service.description}
              </p>
              <p class="eyebrow mt-4 text-xs font-semibold text-teal-600">{service.note}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Section CTA -->
    <div class="mt-14 text-center">
      <a
        href="#contact"
        class="btn-primary px-10 py-4 text-base"
        aria-label="לתיאום ייעוץ ראשוני עם גל עופרי פיזיותרפיה"
      >
        <svg
          class="h-5 w-5 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-linejoin="round"></rect>
          <path stroke-linecap="round" d="M16 2v4M8 2v4M3 10h18"></path>
        </svg>
        לתיאום ייעוץ ראשוני
      </a>
    </div>
  </div>
</section>

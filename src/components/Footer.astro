---
import { SITE } from '@data/site';

const year = new Date().getFullYear();

const navLinks = [
  { href: '#services', label: 'שירותים' },
  { href: '#about', label: 'אודות' },
  { href: '#testimonials', label: 'המלצות' },
  { href: '#contact', label: 'צור קשר' },
];

// Both marks are the brands' own glyphs (Simple Icons), solid, filled with
// currentColor. They used to disagree: Instagram was a hand-drawn Lucide-style
// outline at 1.5px stroke and WhatsApp was the real filled logo, so the two
// circles side by side read as two different icon sets rather than one row.
// If a third social is ever added, take its glyph from the same source — do not
// substitute an outline lookalike.
const socialLinks = [
  {
    label: 'פרופיל האינסטגרם של גל עופרי',
    href: SITE.social.instagram || '#',
    iconPath:
      'M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077',
  },
  {
    label: 'שלחו הודעה לגל עופרי בוואטסאפ',
    href: SITE.whatsappUrl,
    iconPath:
      'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z',
  },
];
---

<footer
  id="site-footer"
  class="border-t-2 border-teal-200 bg-teal-50 pb-16 lg:pb-0"
  aria-label="כותרת תחתונה"
>
  <div class="container-prose py-12 md:py-16">
    <!-- Top grid: brand | nav | contact -->
    <div class="grid gap-10 md:grid-cols-3 md:gap-6">
      <!-- Brand -->
      <div>
        <a href="/" class="group inline-flex flex-col items-start">
          <div class="leading-tight">
            <span
              class="font-heading block text-lg font-semibold text-neutral-900 transition-colors group-hover:text-teal-700"
              >גל עופרי</span
            >
            <span class="block text-sm font-medium text-teal-600">פיזיותרפיה ושיקום</span>
          </div>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-loose text-neutral-600">
          פיזיותרפיסטית מוסמכת בתל אביב, שיקום ספורט, טיפול בכאב וליווי אישי לכל שלב בחיים.
        </p>
      </div>

      <!-- Nav + Contact: side-by-side on mobile, direct grid children on desktop -->
      <div class="grid grid-cols-2 gap-6 md:contents">
        <!-- Navigation links -->
        <nav aria-label="ניווט תחתון">
          <p class="mb-4 text-xs font-bold tracking-wide text-neutral-700">ניווט</p>
          <ul class="space-y-1">
            {
              navLinks.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class="inline-block py-1.5 text-sm text-neutral-600 underline-offset-2 transition-colors hover:text-teal-700 hover:underline pointer-coarse:py-3"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <!-- Contact details -->
        <div>
          <p class="mb-4 text-xs font-bold tracking-wide text-neutral-700">יצירת קשר</p>
          <ul class="space-y-1" aria-label="פרטי יצירת קשר">
            <li>
              <a
                href={`tel:${SITE.phoneE164}`}
                dir="ltr"
                class="inline-block py-1.5 text-sm text-neutral-600 underline-offset-2 transition-colors hover:text-teal-700 hover:underline pointer-coarse:py-3"
                aria-label={`חייגו: ${SITE.phone}`}
              >
                {SITE.phone}
              </a>
            </li>
            <li>
              <a
                href={`mailto:${SITE.email}`}
                class="inline-block py-1.5 text-sm text-neutral-600 underline-offset-2 transition-colors hover:text-teal-700 hover:underline pointer-coarse:py-3"
                aria-label={`שלחו אימייל: ${SITE.email}`}
              >
                {SITE.email}
              </a>
            </li>
            <li>
              <a
                href={`https://maps.google.com/?q=${encodeURIComponent(SITE.address.street + ', ' + SITE.address.cityHebrew)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block py-1.5 text-sm text-neutral-600 underline-offset-2 transition-colors hover:text-teal-700 hover:underline pointer-coarse:py-3"
                aria-label={`פתח מפה: ${SITE.address.street}, ${SITE.address.cityHebrew}`}
              >
                {SITE.address.street}, {SITE.address.cityHebrew}
              </a>
            </li>
          </ul>
        </div>
      </div>{/* /nav+contact wrapper */}
    </div>

    <!-- Divider -->
    <div aria-hidden="true" class="my-10 h-px bg-teal-200"></div>

    <!-- Bottom bar: copyright + policy links + social icons -->
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <div class="flex flex-col items-center gap-2 sm:items-start">
        <p class="text-sm text-neutral-600">© {year} גל עופרי, פיזיותרפיסטית מוסמכת</p>
        <nav
          aria-label="קישורי מדיניות ונגישות"
          class="flex flex-wrap justify-center gap-x-5 gap-y-1 sm:justify-start"
        >
          <a
            href="/privacy"
            class="inline-block py-2 text-xs text-neutral-600 transition-colors hover:text-neutral-700 pointer-coarse:py-3.5"
            >מדיניות פרטיות</a
          >
          <a
            href="/cancellation"
            class="inline-block py-2 text-xs text-neutral-600 transition-colors hover:text-neutral-700 pointer-coarse:py-3.5"
            >מדיניות ביטולים</a
          >
          <a
            href="/accessibility"
            class="inline-block py-2 text-xs text-neutral-600 transition-colors hover:text-neutral-700 pointer-coarse:py-3.5"
            >הצהרת נגישות</a
          >
          <a
            href="/faq"
            class="inline-block py-2 text-xs text-neutral-600 transition-colors hover:text-neutral-700 pointer-coarse:py-3.5"
            >שאלות נפוצות</a
          >
        </nav>
      </div>

      <!-- Social icons -->
      <div class="flex items-center gap-3" role="list" aria-label="קישורי רשתות חברתיות">
        {
          socialLinks.map((social) => (
            <div role="listitem">
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="flex h-11 w-11 items-center justify-center rounded-full border border-teal-200 text-neutral-700 transition-colors duration-200 hover:border-teal-400 hover:text-teal-600"
              >
                {/* One filled path per glyph. The old version split the `d` on
                    ' M' to emit several stroked subpaths, which existed only to
                    serve the outline Instagram icon; brand glyphs are a single
                    path and splitting them would corrupt them. */}
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={social.iconPath} />
                </svg>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</footer>
